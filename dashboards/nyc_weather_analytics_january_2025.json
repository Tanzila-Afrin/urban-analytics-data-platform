          "id": 1,
          "title": "Hourly Temperature - NYC",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "fg51nkuiwuf40a"
                      },
                      "spec": {
                        "query": "\r\nfrom(bucket: \"weather_data\")\r\n  |> range(\r\n      start: 2025-01-01T05:00:00Z,\r\n      stop: 2025-02-01T05:00:00Z\r\n  )\r\n  |> filter(fn: (r) => r._measurement == \"weather\")\r\n  |> filter(fn: (r) => r._field == \"temperature_2m\")\r\n  |> filter(fn: (r) => r.location == \"New York City\")\r\n  |> aggregateWindow(\r\n      every: 1h,\r\n      fn: mean,\r\n      createEmpty: false\r\n  )\r\n  |> yield(name: \"temperature\")\r\n"
                      }
                    },
                    "refId": "A",
                    "hidden": false
